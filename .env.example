COMPOSE_PROJECT_NAME=devops-lab
BACKEND_IMAGE=ghcr.io/maxivalenzano/dev-ops-backend
FRONTEND_IMAGE=ghcr.io/maxivalenzano/dev-ops-frontend
MIGRATOR_IMAGE=ghcr.io/maxivalenzano/dev-ops-migrator
# Secret files are provisioned outside the release .env and never copied to history.
SECRETS_DIR=/opt/devops-lab/secrets
# CI uses <semver>-build.<Build.BuildId>; local builds use local.
IMAGE_TAG=local
PORT=80
